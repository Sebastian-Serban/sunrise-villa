---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getLang, useTranslations } from "../i18n/ui";

const attractions = await getCollection("attractions").then((attractions) =>
	attractions.sort((a, b) => a.data.order - b.data.order),
);

const lang = getLang(Astro.currentLocale);
---

<ul class="attractions">
	{attractions.map(({ data: { image, distance, imageAlt, name, summary, url } }) => {
		// Dont know what to do with url you do it
		const imageNode = (
			<Image
				class="attraction__image"
				src={image}
				alt={imageAlt[lang]}
				widths={[480, 800, 1200]}
				sizes="(max-width: 720px) 100vw, 50vw"
			/>
		);

		return (
			<div>
				<div class="attraction__image__container">
					{!!url ? (
						<a href={url} target="_blank" rel="noopener noreferrer">
							{imageNode}
						</a>
					) : (
						imageNode
					)}
				</div>
				<span class="attraction__distance">{distance[lang]}</span>
				<div>
					<div class="attraction__name">{name}</div>
					<div class="attraction__summary">{summary[lang]}</div>
				</div>
			</div>
		);
	})}
</ul>

<style>
	.attractions {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 24px;
		margin-top: 96px;
	}

	.attraction {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.attraction__distance {
		font-size: 40px;
		line-height: 40px;
		color: var(--tan-deep);
	}

	.attraction__name {
		font-weight: 600;
		font-size: 17px;
		line-height: 24px;
	}

	.attraction__summary {
		font-size: 15px;
		line-height: 22px;
		color: #645e59;
	}

	.attraction__image__container {
		aspect-ratio: 1 / 1;
		position: relative;
		background: var(--photo-placeholder);
		overflow: hidden;
	}

	.attraction__image {
		object-position: center;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transform: scale3d(1.005, 1.005, 1.005);
		transition: transform 0.5s;
	}

	.attraction__image:hover {
		transform: scale3d(1.1, 1.1, 1.1);
	}
</style>
