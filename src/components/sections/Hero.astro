---
import { Image } from 'astro:assets';
import Sweep from '../Sweep.astro';
import hero from '../../assets/hero.jpg';
import { BOOKING_URL, getLang, useTranslations } from '../../i18n/ui';

const t = useTranslations(getLang(Astro.currentLocale));
---

<section class="hero">
	<Image
		class="hero__bg"
		src={hero}
		alt=""
		widths={[800, 1280, 1920, 2400]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="hero__scrim"></div>
	<div class="wrap hero__content">
		<p class="label hero__kicker">{t('hero.kicker')}</p>
		<h1 class="serif h1 hero__title">
			{t('hero.title.before')} <em>{t('hero.title.accent')}</em>
		</h1>
		<p class="lead hero__lead">{t('hero.lead')}</p>
		<div class="hero__actions">
			<a class="btn btn--tan" href={BOOKING_URL}>
				{t('cta.bookOnBooking')}
			</a>
			<a class="btn btn--ghost-dark" href="#camere">
				{t('cta.seeRooms')}
			</a>
		</div>
	</div>
	<div class="hero__sweep">
		<Sweep from="transparent" to="surface" line />
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 940px;
		display: flex;
		align-items: flex-end;
		color: var(--on-dark);
		background: var(--espresso);
	}
	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero__scrim {
		position: absolute;
		inset: 0;
		background: rgb(45 41 38 / 0.5);
	}
	.hero__content {
		position: relative;
		z-index: 2;
		width: 100%;
		padding-bottom: 250px;
	}
	.hero__kicker {
		color: var(--sand);
	}
	.hero__title {
		max-width: 760px;
	}
	.hero__title em {
		font-style: italic;
	}
	.hero__lead {
		margin-top: 28px;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: 36px;
	}
	/* The sweep sits on top of the photo's bottom edge */
	.hero__sweep {
		position: absolute;
		inset: auto 0 -1px;
		z-index: 1;
	}

	@media (max-width: 720px) {
		.hero {
			min-height: 780px;
		}
		.hero__content {
			padding-bottom: 160px;
		}
	}
</style>
