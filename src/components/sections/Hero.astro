---
import { getImage, Image } from "astro:assets";
import BookingBar from "../BookingBar.astro";
import Sweep from "../Sweep.astro";
import hero from "../../assets/hero.jpg";
import { getLang, useTranslations } from "../../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));
// The video's poster is the hero photo, so the first frame matches before playback starts.
const poster = await getImage({ src: hero, width: 1920, format: "webp" });
---

<section class="hero">
	<Image
		class="hero__media"
		src={hero}
		alt=""
		widths={[800, 1280, 1920, 2400]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<video
		class="hero__media hero__video"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		poster={poster.src}
		aria-hidden="true"
	>
		<source src="/video/hero-1080.mp4" type="video/mp4" media="(min-width: 1100px)" />
		<source src="/video/hero.mp4" type="video/mp4" />
	</video>
	<div class="hero__scrim"></div>
	<div class="wrap hero__content">
		<p class="label hero__kicker">{t("hero.kicker")}</p>
		<h1 class="serif h1 hero__title">
			{t("hero.title.before")} <em>{t("hero.title.accent")}</em>
		</h1>
		<p class="lead hero__lead">{t("hero.lead")}</p>
		<div class="hero__booking">
			<BookingBar />
		</div>
	</div>
	<div class="hero__sweep">
		<Sweep from="transparent" to="surface" line />
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 960px;
		display: flex;
		align-items: flex-end;
		color: var(--on-dark);
		background: var(--espresso);
	}
	.hero__media {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero__video {
			display: none;
		}
	}
	.hero__scrim {
		position: absolute;
		inset: 0;
		background: rgb(45 41 38 / 0.5);
	}
	.hero__content {
		position: relative;
		z-index: 2;
		width: 100%;
		padding-top: 160px;
		padding-bottom: 240px;
	}
	.hero__kicker {
		color: var(--sand);
	}
	.hero__title {
		max-width: 760px;
	}
	.hero__title em {
		font-style: italic;
	}
	.hero__lead {
		margin-top: 28px;
	}
	.hero__booking {
		margin-top: 40px;
	}
	/* The sweep sits on top of the photo's bottom edge */
	.hero__sweep {
		position: absolute;
		inset: auto 0 -1px;
		z-index: 1;
	}

	@media (max-width: 720px) {
		.hero {
			min-height: 0;
		}
		.hero__content {
			padding-top: 120px;
			padding-bottom: 130px;
		}
		.hero__lead {
			margin-top: 18px;
		}
		.hero__booking {
			margin-top: 28px;
		}
	}
</style>
