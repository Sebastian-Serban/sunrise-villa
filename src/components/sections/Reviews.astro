---
import { getCollection } from "astro:content";
import { GOOGLE_REVIEWS_URL, getLang, useTranslations } from "../../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));
const reviews = (await getCollection("reviews")).sort((a, b) => a.data.order - b.data.order);
const featured = reviews.find((r) => r.data.featured);
const others = reviews.filter((r) => r !== featured);
---

<section class="section bg-espresso reviews">
	<div class="wrap">
		<div class="reviews__top">
			<div class="score" data-draw>
				<p class="label">{t("reviews.label")}</p>
				<p class="serif score__value">
					9.9
					<svg
						class="score__circle"
						viewBox="0 0 300 200"
						preserveAspectRatio="none"
						aria-hidden="true"
					>
						<path
							class="ink-line"
							stroke="var(--tan)"
							d="M168 16 C 92 10, 22 50, 20 104 C 18 160, 96 188, 172 184 C 248 180, 290 140, 282 90 C 274 40, 214 12, 136 20"
						></path>
					</svg>
				</p>
				<p class="score__text">{t("reviews.score")}</p>
				<p class="score__meta">{t("reviews.meta")}</p>
			</div>
			{featured && (
				<blockquote class="featured" lang="ro">
					<p class="serif">{featured.data.text}</p>
					<cite>{featured.data.author}</cite>
				</blockquote>
			)}
		</div>
		<ul class="quotes">
			{others.map(({ data }) => (
				<li>
					<blockquote class="quote" lang="ro">
						<p>„{data.text}”</p>
						<cite>{data.author}</cite>
					</blockquote>
				</li>
			))}
		</ul>
		<a class="btn btn--ghost-dark reviews__all" href={GOOGLE_REVIEWS_URL}>
			{t("reviews.all")}
		</a>
	</div>
</section>

<style>
	.reviews {
		padding-top: var(--space-12);
	}
	.reviews__top {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--gutter);
		align-items: center;
	}
	.score {
		grid-column: 1 / span 5;
	}
	.score__value {
		position: relative;
		display: inline-block;
		margin: 0;
		font-size: 240px;
		line-height: 0.88;
		color: var(--tan);
	}
	.score__circle {
		position: absolute;
		left: -12%;
		top: -10%;
		width: 124%;
		height: 120%;
		overflow: visible;
	}
	.score__text {
		margin: 28px 0 0;
		font-size: var(--text-body-l);
	}
	.score__meta {
		margin: 4px 0 0;
		font-size: var(--text-small);
		color: var(--on-dark-muted);
	}
	.featured {
		grid-column: 7 / span 6;
		margin: 0;
	}
	.featured::before {
		content: "“";
		display: block;
		height: 56px;
		font-family: var(--font-display);
		font-size: 120px;
		line-height: 1;
		color: var(--tan);
	}
	.featured p {
		margin: 0;
		font-size: 36px;
		line-height: 46px;
	}
	cite {
		display: block;
		margin-top: var(--space-6);
		font-style: normal;
		font-weight: 600;
		font-size: var(--text-small);
		color: var(--tan);
	}
	.quotes {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 40px;
		margin: var(--space-24) 0 0;
		padding: 0;
		list-style: none;
	}
	.quote {
		height: 100%;
		margin: 0;
		padding: 36px;
		background: var(--espresso-raised);
	}
	.quote p {
		margin: 0;
		font-size: 20px;
		line-height: 30px;
	}
	.reviews__all {
		margin-top: var(--space-12);
	}

	@media (max-width: 1000px) {
		.score,
		.featured {
			grid-column: 1 / -1;
		}
		.featured {
			margin-top: var(--space-12);
		}
		.quotes {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-4);
		}
	}
	@media (max-width: 720px) {
		.reviews {
			padding-top: var(--space-6);
		}
		.score__value {
			font-size: 140px;
		}
		.featured p {
			font-size: 26px;
			line-height: 35px;
		}
		.quotes {
			display: flex;
			gap: var(--space-3);
			margin: var(--space-8) calc(-1 * var(--page-pad)) 0;
			padding: 0 var(--page-pad) var(--space-2);
			overflow-x: auto;
			scroll-snap-type: x mandatory;
		}
		.quotes li {
			flex: none;
			width: 300px;
			scroll-snap-align: start;
		}
		.quote {
			padding: var(--space-6);
		}
		.quote p {
			font-size: 18px;
			line-height: 27px;
		}
		.reviews__all {
			width: 100%;
			margin-top: 28px;
		}
	}
</style>
