---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import AppIcon from "../AppIcon.astro";
import { ADDRESS, EMAIL, PHONE, PHONE_HREF, getLang, useTranslations } from "../../i18n/ui";

interface Props {
	/** Which page the form is on, so contact.php can send the guest back there. */
	page?: "home" | "contact";
	/** Show the reception hours (contact page). */
	reception?: boolean;
}

const { page = "home", reception = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// "Ask about this room" links arrive with ?camera=<anchor>; pre-fill the message.
const rooms = await getCollection("rooms");
const enquiries = Object.fromEntries(rooms.map(({ data }) => [data.anchor, data.enquiry[lang]]));
---

<section id="contact" class="contact">
	<div class="contact__split" data-draw aria-hidden="true">
		<svg viewBox="0 0 1440 900" preserveAspectRatio="none">
			<path
				fill="var(--tan)"
				d="M0 150 C 110 70, 300 40, 460 62 C 590 80, 670 150, 648 270 C 626 390, 598 470, 652 580 C 712 700, 800 760, 760 900 L0 900 Z"
			></path>
		</svg>
		<svg viewBox="0 0 1440 900" preserveAspectRatio="none">
			<path
				transform="translate(-90 0)"
				class="ink-line"
				stroke="var(--espresso)"
				d="M330 34 C 470 30, 650 80, 676 170 C 700 260, 640 380, 640 450 C 640 540, 700 590, 760 560 C 800 540, 780 492, 740 500 C 700 510, 704 590, 742 650 C 790 730, 830 800, 790 910"
			></path>
		</svg>
	</div>

	<div class="wrap contact__layout">
		<div class="contact__info">
			<p class="label">{t("contact.label")}</p>
			<h2 class="serif h2">{t("contact.title")}</h2>
			<p class="lead contact__lead">{t("contact.lead")}</p>
			<ul class="contact__list">
				<li>
					<AppIcon name="Phone" />
					<div>
						<small>{t("contact.phone")}</small>
						<a href={PHONE_HREF}>{PHONE}</a>
					</div>
				</li>
				<li>
					<AppIcon name="Mail" />
					<div>
						<small>{t("contact.email")}</small>
						<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
					</div>
				</li>
				<li>
					<AppIcon name="MapPin" />
					<div>
						<small>{t("contact.address")}</small>
						{ADDRESS}
					</div>
				</li>
				{reception && (
					<li>
						<AppIcon name="BellRing" />
						<div>
							<small>{t("contact.reception")}</small>
							{t("contact.reception.value")}
						</div>
					</li>
				)}
				<li>
					<AppIcon name="Clock" />
					<div>
						<small>{t("contact.times")}</small>
						{t("contact.times.value")}
					</div>
				</li>
			</ul>
		</div>

		<form class="form" method="post" action="/contact.php" aria-label={t("form.label")}>
			<input type="hidden" name="lang" value={lang} />
			<input type="hidden" name="page" value={page} />
			<!-- Honeypot: humans never see or fill this -->
			<div class="form__trap" aria-hidden="true">
				<label for="contact-website">Website</label>
				<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
			</div>
			<div class="field">
				<label for="contact-name">{t("form.name")}</label>
				<input id="contact-name" name="name" type="text" autocomplete="name" required />
			</div>
			<div class="field">
				<label for="contact-email">{t("form.email")}</label>
				<input id="contact-email" name="email" type="email" autocomplete="email" required />
			</div>
			<div class="field">
				<label for="contact-phone">{t("form.phone")}</label>
				<input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
			</div>
			<div class="field">
				<label for="contact-dates">{t("form.dates")}</label>
				<input id="contact-dates" name="dates" type="text" />
			</div>
			<div class="field field--full">
				<label for="contact-message">{t("form.message")}</label>
				<textarea
					id="contact-message"
					name="message"
					required
					data-enquiries={JSON.stringify(enquiries)}
				></textarea>
			</div>
			<p
				class="form__status"
				role="status"
				hidden
				data-sent={t("form.sent")}
				data-error={t("form.error")}
			></p>
			<div class="field--full form__foot">
				<span class="muted">
					{t("form.privacy")}
					<a href={getRelativeLocaleUrl(lang, "confidentialitate")}>{t("form.privacyLink")}</a>
				</span>
				<button class="btn btn--primary" type="submit">
					{t("form.submit")}
				</button>
			</div>
		</form>
	</div>
</section>

<script>
	// contact.php redirects back with ?sent=1 or ?error=1
	const status = document.querySelector<HTMLElement>(".form__status");
	const params = new URLSearchParams(window.location.search);
	const state = params.has("sent") ? "sent" : params.has("error") ? "error" : null;
	const message = document.querySelector<HTMLTextAreaElement>("#contact-message");
	const room = params.get("camera");
	if (message && room && !message.value) {
		const enquiries = JSON.parse(message.dataset.enquiries ?? "{}") as Record<string, string>;
		message.value = enquiries[room] ?? "";
	}
	if (status && state) {
		status.textContent = status.dataset[state] ?? "";
		status.dataset.state = state;
		status.hidden = false;
		history.replaceState(null, "", window.location.pathname + "#contact");
	}
</script>

<style>
	.contact {
		position: relative;
	}
	.contact__split {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.contact__split svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.contact__layout {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--gutter);
		padding-block: 180px 140px;
	}
	.contact__info {
		grid-column: 1 / span 5;
		color: var(--espresso);
	}
	.contact__info .label {
		color: var(--espresso);
	}
	.contact__lead {
		margin-top: var(--space-6);
	}
	.contact__list {
		display: flex;
		flex-direction: column;
		gap: 22px;
		margin: 40px 0 0;
		padding: 0;
		list-style: none;
		font-size: 18px;
		line-height: 26px;
	}
	.contact__list li {
		display: flex;
		gap: var(--space-4);
		align-items: flex-start;
	}
	.contact__list li :global(.app-icon) {
		margin-top: 3px;
	}
	.contact__list small {
		display: block;
		font-size: var(--text-label);
		line-height: 20px;
		font-weight: 600;
	}
	.contact__list a {
		color: var(--espresso);
		text-decoration: none;
		border-bottom: 1px solid var(--espresso);
	}

	.form {
		grid-column: 7 / span 6;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px var(--space-6);
		align-content: start;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.field--full {
		grid-column: 1 / -1;
	}
	.field label {
		font-size: var(--text-label);
		line-height: 20px;
		font-weight: 600;
	}
	.field input,
	.field textarea {
		font: inherit;
		font-size: var(--text-body);
		height: 52px;
		padding: 0 14px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		background: var(--surface-raised);
		color: var(--ink);
	}
	.field textarea {
		height: 140px;
		padding: 12px 14px;
		resize: vertical;
	}
	.form__foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-4);
		font-size: var(--text-small);
		line-height: 22px;
	}
	.form__trap {
		position: absolute;
		left: -9999px;
	}
	.form__status {
		grid-column: 1 / -1;
		margin: 0;
		padding: var(--space-3) var(--space-4);
		border-left: 0;
		background: var(--sand);
		color: var(--success);
		font-weight: 600;
	}
	.form__status[data-state="error"] {
		color: var(--error);
	}

	@media (max-width: 720px) {
		.contact__split {
			display: none;
		}
		.contact__layout {
			display: block;
			padding-block: 0;
		}
		.contact__info {
			margin: 0 calc(-1 * var(--page-pad));
			padding: 56px var(--page-pad) 48px;
			background: var(--tan);
		}
		.form {
			grid-template-columns: minmax(0, 1fr);
			padding-block: 40px 64px;
		}
		.form__foot .btn {
			width: 100%;
		}
	}
</style>
