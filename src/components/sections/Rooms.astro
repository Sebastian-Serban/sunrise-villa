---
import { Image } from "astro:assets";
import AppIcon from "../AppIcon.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, useTranslations } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const rooms = (await getCollection("rooms")).sort((a, b) => a.data.order - b.data.order);
const roomsPage = getRelativeLocaleUrl(lang, "camere");
---

<section id="camere" class="section rooms">
	<div class="wrap">
		<p class="label">{t("rooms.label")}</p>
		<h2 class="serif h2">{t("rooms.title")}</h2>
		<p class="lead muted rooms__lead">{t("rooms.lead")}</p>
		<div class="rooms__grid">
			{rooms.map(({ data }) => (
				<article class="room">
					<Image
						src={data.photos[0].image}
						alt={data.photos[0].alt[lang]}
						widths={[480, 800, 1200]}
						sizes="(max-width: 1000px) 100vw, 33vw"
						class="room__img"
					/>
					<div class="room__body">
						<h3 class="serif h3">{data.name[lang]}</h3>
						<ul class="room__chips">
							<li>
								<AppIcon name="BedDouble" />
								{data.beds[lang]}
							</li>
							<li>
								<AppIcon name="Users" />
								{data.maxPersons} {t("rooms.persons")}
							</li>
							<li>
								<AppIcon name="Ruler" />
								{data.sizeM2} m²
							</li>
						</ul>
						<p class="muted">{data.description[lang]}</p>
						<a class="room__link" href={`${roomsPage}#${data.anchor}`}>
							{t("rooms.details")}
						</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.rooms__lead {
		margin-top: var(--space-6);
	}
	.rooms__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: start;
		gap: 32px;
		margin-top: 72px;
	}
	.room {
		background: var(--surface-raised);
	}
	/* Stagger the cards down to the right. */
	.room:nth-child(2) {
		margin-top: 72px;
	}
	.room:nth-child(3) {
		margin-top: 144px;
	}
	.room__img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}
	.room__body {
		padding: 32px 32px 36px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.room__body p {
		margin: 0;
	}
	.room__link {
		align-self: flex-start;
		padding-bottom: 2px;
		border-bottom: 2px solid var(--tan);
		color: var(--espresso);
		font-weight: 600;
		text-decoration: none;
	}
	.room__link:hover {
		color: var(--tan-deep);
	}
	.room__chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.room__chips li {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: var(--sand);
		padding: 8px 12px;
		font-size: var(--text-small);
		line-height: 20px;
		border-radius: var(--radius-sm);
	}

	@media (max-width: 1000px) {
		.rooms__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 28px;
		}
		.room:nth-child(n) {
			margin-top: 0;
		}
		.room__img {
			aspect-ratio: 4 / 3;
		}
	}

	@media (max-width: 720px) {
		.room__body {
			padding: 28px 24px 32px;
		}
	}
</style>
