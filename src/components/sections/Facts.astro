---
import { getLang, useTranslations } from "../../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));
const facts = [
	{ value: "9.9", text: t("facts.booking") },
	{ value: "4.8", text: t("facts.google") },
	{ value: "2 km", text: t("facts.center") },
	{ value: "8 km", text: t("facts.oradea") },
];
---

<div class="wrap">
	<dl class="facts">
		{facts.map((fact) => (
			<div class="fact">
				<dt class="serif fact__value">{fact.value}</dt>
				<dd class="fact__text">{fact.text}</dd>
			</div>
		))}
	</dl>
</div>

<style>
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6) var(--space-16);
		margin: 40px 0 0;
	}
	.fact {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
	}
	.fact__value {
		font-size: 56px;
		line-height: 1;
	}
	.fact__text {
		margin: 0;
		font-size: var(--text-small);
		line-height: 20px;
		color: var(--ink-muted);
		max-width: 9em;
	}
	@media (max-width: 720px) {
		.facts {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 22px 16px;
			margin-top: 24px;
		}
		.fact {
			flex-direction: column;
			gap: 4px;
		}
		.fact__value {
			font-size: 40px;
		}
	}
</style>
