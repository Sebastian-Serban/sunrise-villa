---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import lake from "../../assets/lake.jpg";
import { getLang, useTranslations } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const attractions = (await getCollection("attractions")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<section id="imprejurimi" class="section surroundings">
	<div class="wrap">
		<div class="lake">
			<Image
				class="lake__img"
				src={lake}
				alt={t("area.lake.alt")}
				widths={[480, 800, 1200, 1600]}
				sizes="(max-width: 1000px) 100vw, 66vw"
			/>
			<div class="lake__text">
				<p class="label">{t("area.label")}</p>
				<h2 class="serif h2">{t("area.title")}</h2>
				<p class="lead lake__lead">{t("area.lead")}</p>
			</div>
		</div>

		<ul class="tiles">
			{attractions.map(({ data }) => {
				const Tag = data.url ? "a" : "div";
				return (
					<li>
						<Tag
							class="tile"
							href={data.url}
							target={data.url ? "_blank" : undefined}
							rel={data.url ? "noopener" : undefined}
						>
							<div class="tile__media">
								<Image
									class="tile__img"
									src={data.image}
									alt={data.imageAlt[lang]}
									widths={[480, 600]}
									sizes="(max-width: 720px) 220px, 25vw"
								/>
							</div>
							<span class="serif tile__distance">{data.distance[lang]}</span>
							<span class="tile__name">{data.name}</span>
							<span class="tile__summary">{data.summary[lang]}</span>
						</Tag>
					</li>
				);
			})}
		</ul>
	</div>
</section>

<style>
	.surroundings {
		padding-top: var(--space-16);
	}
	.lake {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--gutter);
		align-items: center;
	}
	.lake__img {
		grid-column: 1 / span 8;
		grid-row: 1;
		width: 100%;
		height: 640px;
		object-fit: cover;
	}
	.lake__text {
		grid-column: 7 / span 6;
		grid-row: 1;
		position: relative;
		z-index: 1;
		padding: 56px;
		background: var(--sand);
	}
	.lake__lead {
		margin-top: var(--space-6);
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-6);
		margin: var(--space-24) 0 0;
		padding: 0;
		list-style: none;
	}
	.tile {
		display: flex;
		flex-direction: column;
		gap: 6px;
		color: inherit;
		text-decoration: none;
	}
	.tile__media {
		aspect-ratio: 1 / 1;
		overflow: hidden;
		margin-bottom: 8px;
		background: var(--photo-placeholder);
	}
	.tile__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 500ms ease;
	}
	a.tile:hover .tile__img {
		transform: scale(1.06);
	}
	a.tile:hover .tile__name {
		text-decoration: underline;
	}
	@media (prefers-reduced-motion: reduce) {
		.tile__img {
			transition: none;
		}
	}
	.tile__distance {
		font-size: 40px;
		line-height: 1;
		color: var(--tan-deep);
	}
	.tile__name {
		font-weight: 600;
		line-height: 24px;
	}
	.tile__summary {
		font-size: var(--text-small);
		line-height: 22px;
		color: var(--ink-muted);
	}

	@media (max-width: 1000px) {
		.lake__img {
			grid-column: 1 / -1;
		}
		.lake__text {
			grid-column: 3 / -1;
			grid-row: 2;
			margin-top: -160px;
		}
		.tiles {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 720px) {
		.surroundings {
			padding-top: var(--space-8);
		}
		.lake {
			display: block;
		}
		.lake__img {
			height: 340px;
			margin-inline: calc(-1 * var(--page-pad));
			width: calc(100% + 2 * var(--page-pad));
			max-width: none;
		}
		.lake__text {
			margin: -56px 0 0 var(--space-4);
			padding: 28px 22px;
		}
		.tiles {
			display: flex;
			gap: var(--space-3);
			margin: var(--space-12) calc(-1 * var(--page-pad)) 0;
			padding: 0 var(--page-pad) var(--space-2);
			overflow-x: auto;
			scrollbar-width: none;
		}
		.tiles li {
			flex: none;
			width: 220px;
			scroll-snap-align: start;
		}
		.tile__distance {
			font-size: 30px;
		}
	}
</style>
