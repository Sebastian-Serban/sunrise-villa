---
import { getCollection } from "astro:content";
import { getLang, useTranslations } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const items = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
---

<section id="intrebari" class="section faq">
	<div class="wrap faq__layout">
		<div class="faq__head">
			<p class="label">{t("faq.label")}</p>
			<h2 class="serif h2">{t("faq.title")}</h2>
			<p class="lead muted faq__lead">{t("faq.lead")}</p>
		</div>
		<div class="faq__list">
			{items.map(({ data }, index) => (
				<details class="qa" open={index === 0}>
					<summary class="serif">{data.question[lang]}</summary>
					<p>{data.answer[lang]}</p>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.faq {
		padding-top: var(--space-8);
	}
	.faq__layout {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--gutter);
		align-items: start;
	}
	.faq__head {
		grid-column: 1 / span 4;
	}
	.faq__lead {
		margin-top: 20px;
	}
	.faq__list {
		grid-column: 6 / span 7;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.qa {
		background: var(--sand);
	}
	.qa summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-4);
		padding: 22px 28px;
		font-size: 22px;
		line-height: 30px;
		list-style: none;
		cursor: pointer;
	}
	.qa summary::-webkit-details-marker {
		display: none;
	}
	.qa summary::after {
		content: "+";
		flex: none;
		font-family: var(--font-sans);
		font-size: 26px;
		color: var(--tan-deep);
	}
	.qa[open] summary::after {
		content: "−";
	}
	.qa p {
		margin: 0;
		padding: 0 28px 24px;
		max-width: 40em;
	}
	@media (max-width: 1000px) {
		.faq__head,
		.faq__list {
			grid-column: 1 / -1;
		}
		.faq__head {
			margin-bottom: 40px;
		}
	}
	@media (max-width: 720px) {
		.faq {
			padding-top: var(--space-4);
		}
		.qa summary {
			padding: 18px 20px;
			font-size: 19px;
			line-height: 26px;
		}
		.qa p {
			padding: 0 20px 20px;
			font-size: 16px;
		}
	}
</style>
