---
/** Floating phone / WhatsApp / email buttons, fixed to the bottom right on every page. */
import AppIcon from "./AppIcon.astro";
import { EMAIL, PHONE_HREF, WHATSAPP_HREF, getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));
---

<div class="dock">
	<a class="dock__btn dock__btn--call" href={PHONE_HREF} aria-label={t("dock.call")}>
		<AppIcon name="Phone" stroke-width={2} />
	</a>
	<a
		class="dock__btn dock__btn--whatsapp"
		href={WHATSAPP_HREF}
		target="_blank"
		rel="noopener"
		aria-label={t("dock.whatsapp")}
	>
		<AppIcon name="MessageCircle" stroke-width={2} />
	</a>
	<a class="dock__btn dock__btn--mail" href={`mailto:${EMAIL}`} aria-label={t("dock.email")}>
		<AppIcon name="Mail" stroke-width={2} />
	</a>
</div>

<style>
	.dock {
		position: fixed;
		right: 10px;
		bottom: 16px;
		z-index: 30;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.dock__btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: var(--radius-full);
		color: var(--white);
		box-shadow: var(--shadow-float);
	}
	.dock__btn:hover {
		color: var(--white);
		filter: brightness(1.08);
	}
	.dock__btn:focus-visible {
		outline-color: var(--white);
		outline-offset: 2px;
		box-shadow:
			0 0 0 2px var(--espresso),
			var(--shadow-float);
	}
	.dock__btn--call {
		background: var(--call);
	}
	.dock__btn--whatsapp {
		background: var(--whatsapp);
	}
	.dock__btn--mail {
		background: var(--mail);
	}
	@media (min-width: 900px) {
		.dock {
			right: 20px;
			bottom: 24px;
			gap: 10px;
		}
		.dock__btn {
			width: 46px;
			height: 46px;
		}
	}
</style>
