---
/**
 * Photo banner with the page title, used by the rooms and contact pages.
 * Phone: title at the bottom left. Desktop: title (and the optional lead) bottom left on the
 * container grid. The lead only shows from 900px; phone pages put it in the text below.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	image: ImageMetadata;
	title: string;
	/** Desktop-only paragraph under the title. */
	lead?: string;
	/** tall: 300px phone / 440px desktop. Default: 260px / 400px. */
	tall?: boolean;
}

const { image, title, lead, tall = false } = Astro.props;
---

<section class:list={["banner", { "banner--tall": tall }]}>
	<Image
		class="banner__img"
		src={image}
		alt=""
		widths={[640, 960, 1440, 1920]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="banner__scrim"></div>
	<div class="banner__content">
		<h1>{title}</h1>
		{lead && <p class="banner__lead">{lead}</p>}
	</div>
</section>

<style>
	.banner {
		position: relative;
		display: flex;
		align-items: flex-end;
		height: 260px;
		color: var(--white);
	}
	.banner--tall {
		height: 300px;
	}
	.banner__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.banner__scrim {
		position: absolute;
		inset: 0;
		background: rgb(20 17 15 / 0.5);
	}
	.banner__content {
		position: relative;
		width: 100%;
		padding: 0 var(--page-pad) 30px;
	}
	.banner--tall .banner__content {
		padding-bottom: 32px;
	}
	h1 {
		margin: 0;
		font-size: 36px;
		line-height: 1.15;
		font-weight: 700;
		color: var(--tan);
	}
	.banner__lead {
		display: none;
	}

	@media (min-width: 900px) {
		.banner {
			height: 400px;
		}
		.banner--tall {
			height: 440px;
		}
		.banner__scrim {
			background: rgb(20 17 15 / 0.45);
		}
		.banner--tall .banner__scrim {
			background: rgb(20 17 15 / 0.5);
		}
		.banner__content,
		.banner--tall .banner__content {
			max-width: calc(var(--content-max) + 2 * var(--page-pad));
			margin-inline: auto;
			padding: 0 var(--page-pad) 56px;
		}
		h1 {
			font-size: 52px;
			line-height: 1.1;
		}
		.banner__lead {
			display: block;
			max-width: 760px;
			margin: 14px 0 0;
			font-size: 18px;
			color: #f2ede6;
		}
	}
</style>
