---
/**
 * Curved section divider: the site's signature.
 * Paints the colour of the section above (`from`) and fills a diagonal curve
 * with the colour of the section below (`to`). Optionally a cursive line with
 * a loop rides along the edge and draws itself in on scroll.
 *
 * Shapes are placeholders until the hand-drawn set exists (see docs/sunrise-villa.md).
 */
type Ground = 'surface' | 'sand' | 'tan' | 'espresso';

interface Props {
	/** 'transparent' when the divider sits on top of a photo. */
	from: Ground | 'transparent';
	to: Ground;
	/** Which curve to use. Alternate them so consecutive dividers don't repeat. */
	shape?: 'fall' | 'rise';
	/** Show the cursive line with a loop. Use sparingly: big transitions only. */
	line?: boolean;
}

const { from, to, shape = 'fall', line = false } = Astro.props;

const colour: Record<Ground | 'transparent', string> = {
	transparent: 'transparent',
	surface: 'var(--surface)',
	sand: 'var(--sand)',
	tan: 'var(--tan)',
	espresso: 'var(--espresso)',
};

// Line colour must contrast with both sides of the edge.
const lineColour = from === 'tan' || to === 'tan' ? 'var(--espresso)' : 'var(--tan)';

const shapes = {
	fall: {
		fill: 'M0 30 C 300 40, 600 120, 900 140 C 1140 156, 1320 150, 1440 146 L1440 180 L0 180 Z',
		line: 'M-20 22 C 280 32, 520 96, 640 118 C 700 130, 760 118, 752 90 C 744 62, 700 68, 704 98 C 708 130, 800 142, 920 150 C 1140 166, 1320 160, 1460 156',
	},
	rise: {
		fill: 'M0 150 C 280 150, 520 120, 760 80 C 1000 40, 1240 20, 1440 16 L1440 180 L0 180 Z',
		line: 'M-20 168 C 260 166, 480 140, 620 112 C 700 96, 760 70, 740 48 C 720 26, 676 44, 700 76 C 730 116, 820 80, 960 52 C 1160 16, 1320 8, 1460 6',
	},
} as const;

const s = shapes[shape];
---

<div
	class="sweep"
	style={`--from: ${colour[from]}; --to: ${colour[to]}`}
	aria-hidden="true"
	data-draw={line ? '' : undefined}
>
	<svg viewBox="0 0 1440 180" preserveAspectRatio="none">
		<path d={s.fill} fill="var(--to)"></path>
	</svg>
	{line && (
		<svg viewBox="0 0 1440 180" preserveAspectRatio="none">
			<path class="ink-line" d={s.line} stroke={lineColour} pathLength="1" />
		</svg>
	)}
</div>

<style>
	.sweep {
		position: relative;
		height: 180px;
		background: var(--from);
		line-height: 0;
	}
	.sweep svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	@media (max-width: 720px) {
		.sweep {
			height: 90px;
		}
	}
</style>
