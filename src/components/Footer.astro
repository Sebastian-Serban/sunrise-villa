---
/** Site footer with the click-to-load map above it. Shared by every page. */
import { pageUrl } from "../i18n/routes";
import MapSection from "./MapSection.astro";
import { EMAIL, PHONE, PHONE_HREF, SOCIAL_LINKS, getLang, useTranslations } from "../i18n/ui";

interface Props {
	/** Show the map section above the footer. */
	map?: boolean;
}

const { map = true } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const links = [
	{ page: "home", label: t("nav.home") },
	{ page: "rooms", label: t("nav.rooms") },
	{ page: "gallery", label: t("nav.gallery") },
	{ page: "contact", label: t("nav.contact") },
] as const;
---

{map && <MapSection />}

<footer class="footer bg-espresso">
	<div class="footer__inner">
		<div class="footer__grid">
			<div class="footer__brand">
				<p class="footer__name">Sunrise Villa</p>
				<p class="footer__tagline">{t("footer.tagline")}</p>
				<div class="footer__contact">
					<a href={PHONE_HREF}>{PHONE}</a>
					<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
				</div>
				<ul class="footer__social" aria-label={t("footer.social")}>
					{SOCIAL_LINKS.map((link) => (
						<li>
							<a href={link.href} target="_blank" rel="noopener" aria-label={link.name}>
								{link.name === "Facebook" && <span aria-hidden="true">f</span>}
								{link.name === "Instagram" && (
									<svg
										width="20"
										height="20"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										aria-hidden="true"
									>
										<rect width="20" height="20" x="2" y="2" rx="5" />
										<circle cx="12" cy="12" r="4" />
									</svg>
								)}
								{link.name === "TikTok" && (
									<svg
										width="20"
										height="20"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										aria-hidden="true"
									>
										<path d="M14 3v12a4 4 0 1 1-4-4M14 3c.5 3 2.5 5 6 5" />
									</svg>
								)}
							</a>
						</li>
					))}
				</ul>
			</div>

			<nav class="footer__col" aria-label={t("footer.pages")}>
				<h2>{t("footer.pages")}</h2>
				<ul>
					{links.map((link) => (
						<li>
							<a href={pageUrl(lang, link.page)}>{link.label}</a>
						</li>
					))}
				</ul>
			</nav>

			<div class="footer__col footer__col--info">
				<h2>{t("footer.rules")}</h2>
				<ul>
					<li>{t("footer.rules.checkin")}</li>
					<li>{t("footer.rules.checkout")}</li>
					<li class="footer__desktop-only">{t("footer.rules.reception")}</li>
					<li>{t("footer.rules.pets")}</li>
					<li>{t("footer.rules.smoking")}</li>
				</ul>
			</div>
		</div>

		<div class="footer__bottom">
			<span>
				© {year} Sunrise Villa. {t("footer.rights")}
			</span>
			<span>
				<a href={pageUrl(lang, "privacy")}>{t("footer.privacy")}</a> ·
				<a href="https://anpc.ro/">ANPC</a>
			</span>
		</div>
	</div>
</footer>

<style>
	.footer {
		padding: 44px 24px 28px;
		font-size: 16px;
		line-height: 1.6;
	}
	.footer__inner {
		max-width: var(--content-max);
		margin-inline: auto;
	}
	.footer__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 32px 24px;
		margin-bottom: 28px;
	}
	.footer__brand {
		grid-column: 1 / -1;
	}
	.footer__name {
		margin: 0 0 8px;
		font-size: 22px;
		font-weight: 700;
		color: var(--tan);
	}
	.footer__tagline {
		margin: 0 0 18px;
	}
	.footer__contact {
		display: none;
		flex-direction: column;
		gap: 4px;
		margin-bottom: 20px;
	}
	.footer__social {
		display: flex;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.footer__social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: 1px solid #5a534d;
		border-radius: var(--radius-full);
		color: var(--on-dark-strong);
		font-weight: 700;
		text-decoration: none;
	}
	.footer__social a:hover {
		border-color: var(--tan);
		color: var(--tan);
	}
	.footer__col h2 {
		margin: 0 0 10px;
		font-size: 16px;
		font-weight: 700;
		color: var(--tan);
	}
	.footer__col ul {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.footer__col--info ul {
		font-size: 15px;
		line-height: 1.4;
	}
	.footer__desktop-only {
		display: none;
	}
	.footer a {
		color: var(--on-dark-strong);
		text-decoration: none;
	}
	.footer__col a:hover,
	.footer__contact a:hover {
		color: var(--tan);
	}
	.footer__bottom {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-top: 18px;
		border-top: 1px solid var(--line-dark);
		font-size: 14px;
		color: var(--on-dark-muted);
	}
	.footer__bottom a {
		text-decoration: underline;
	}
	.footer__bottom a:hover {
		color: var(--tan);
	}

	@media (min-width: 900px) {
		.footer {
			padding: 72px var(--page-pad) 32px;
		}
		.footer__grid {
			grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
			gap: 48px;
			margin-bottom: 48px;
		}
		.footer__brand {
			grid-column: auto;
		}
		.footer__name {
			margin-bottom: 10px;
			font-size: 24px;
		}
		.footer__contact {
			display: flex;
		}
		.footer__col h2 {
			margin-bottom: 14px;
			font-size: 18px;
		}
		.footer__col ul {
			gap: 8px;
		}
		.footer__col--info ul {
			font-size: 16px;
			line-height: inherit;
		}
		.footer__desktop-only {
			display: list-item;
		}
		.footer__bottom {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 12px;
			padding-top: 22px;
		}
	}
</style>
