---
/**
 * Gallery page: photo hero, category filter, photo grid and the full-screen viewer.
 * Phone shows a two-column grid with tall and featured photos; desktop a uniform grid.
 * Behaviour (filter, viewer, swipe, keyboard) lives in src/scripts/gallery.ts.
 */
import { getImage, Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import AppIcon from "../AppIcon.astro";
import Footer from "../Footer.astro";
import Header from "../Header.astro";
import heroImage from "../../assets/spaces/pool-aerial.jpg";
import { getLang, useTranslations } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const entries = (await getCollection("gallery")).sort((a, b) => a.data.order - b.data.order);
const photos = await Promise.all(
	entries.map(async ({ data }) => ({
		...data,
		// Large version for the viewer; never upscale past the original.
		full: await getImage({
			src: data.image,
			width: Math.min(1920, data.image.width),
			format: "webp",
		}),
		// Small version for the viewer's thumbnail strip
		thumb: await getImage({ src: data.image, width: 176, height: 120, format: "webp" }),
	})),
);

const categories = ["toate", "camere", "gradina", "interior", "drona"] as const;

// Initial phone layout for the unfiltered grid (the script recomputes it per filter)
let featured = 0;
const shapes = photos.map((photo) => {
	if (photo.tall) return "tall";
	return featured++ % 7 === 0 ? "wide" : "small";
});
---

<Base
	page="gallery"
	title={t("galleryPage.meta.title")}
	description={t("galleryPage.meta.description")}
>
	<Header page="gallery" />
	<main>
		<section class="hero">
			<Image
				class="hero__img"
				src={heroImage}
				alt=""
				widths={[640, 960, 1440, 1920]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="hero__scrim"></div>
			<div class="hero__inner">
				<h1>{t("galleryPage.title")}</h1>
			</div>
		</section>

		<gallery-browser class="gallery">
			<div class="filters" role="group" aria-label={t("galleryPage.filter")} data-filters hidden>
				{categories.map((c) => (
					<button
						class="filters__btn"
						type="button"
						data-filter={c}
						aria-pressed={c === "toate" ? "true" : "false"}
					>
						{t(`galleryPage.cat.${c}`)}
					</button>
				))}
			</div>

			<div class="grid" data-grid>
				{photos.map((photo, i) => (
					<button
						class="grid__item"
						type="button"
						data-photo
						data-cat={photo.category}
						data-tall={photo.tall}
						data-shape={shapes[i]}
						data-full={photo.full.src}
						data-thumb={photo.thumb.src}
						data-alt={photo.alt[lang]}
						aria-label={`${t("galleryPage.open")} ${photo.alt[lang]}`}
					>
						<Image
							src={photo.image}
							alt=""
							widths={[400, 640, 900, 1200]}
							sizes="(max-width: 899px) 60vw, 380px"
						/>
					</button>
				))}
			</div>
			<p class="gallery__hint">{t("galleryPage.hint")}</p>

			<dialog class="viewer" aria-label={t("galleryPage.viewer.label")} data-viewer>
				<span class="viewer__count" aria-live="polite" data-count></span>
				<button class="viewer__close" type="button" data-close aria-label={t("lightbox.close")}>
					<AppIcon name="X" stroke-width={2} />
				</button>
				<div class="viewer__stage" data-stage>
					<button
						class="viewer__arrow viewer__arrow--prev"
						type="button"
						data-prev
						aria-label={t("carousel.prev")}
					>
						<AppIcon name="ChevronLeft" stroke-width={2.2} />
					</button>
					<img class="viewer__img" alt="" width="1920" height="1280" data-img />
					<button
						class="viewer__arrow viewer__arrow--next"
						type="button"
						data-next
						aria-label={t("carousel.next")}
					>
						<AppIcon name="ChevronRight" stroke-width={2.2} />
					</button>
				</div>
				<p class="viewer__caption" data-caption></p>
				<div class="viewer__thumbs" data-thumbs></div>
				<p class="viewer__hint">{t("galleryPage.viewer.hint")}</p>
			</dialog>
		</gallery-browser>
	</main>
	<Footer />
</Base>

<script>
	import "../../scripts/gallery";
</script>

<style>
	/* Page hero: photo with a scrim and the title in tan */
	.hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		height: 260px;
		padding: 0 var(--page-pad) 30px;
		color: var(--white);
	}
	.hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero__scrim {
		position: absolute;
		inset: 0;
		background: rgb(20 17 15 / 0.5);
	}
	.hero__inner {
		position: relative;
		width: 100%;
		max-width: var(--content-max);
		margin-inline: auto;
	}
	h1 {
		margin: 0;
		font-size: 36px;
		line-height: 1.15;
		font-weight: 700;
		color: var(--tan);
	}

	.gallery {
		display: block;
		max-width: calc(var(--content-max) + 2 * var(--page-pad));
		margin-inline: auto;
		padding: 28px 16px 56px;
	}

	/* Filter pills */
	.filters {
		display: flex;
		gap: var(--space-2);
		overflow-x: auto;
		padding: 0 var(--space-2) 20px;
		scrollbar-width: none;
	}
	.filters[hidden] {
		display: none;
	}
	.filters__btn {
		flex: none;
		height: 40px;
		padding: 0 16px;
		border: 1px solid var(--border-strong);
		border-radius: 20px;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: var(--text-small);
		cursor: pointer;
	}
	.filters__btn:hover {
		background: var(--sand);
	}
	.filters__btn[aria-pressed="true"] {
		border-color: var(--espresso);
		background: var(--espresso);
		color: var(--on-dark-strong);
		font-weight: 600;
	}

	/* Photo grid, phone: two columns with tall and featured photos */
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-rows: clamp(120px, 31vw, 200px);
		grid-auto-flow: dense;
		gap: var(--space-2);
	}
	.grid__item {
		display: block;
		min-width: 0;
		padding: 0;
		border: 0;
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--photo-placeholder);
		cursor: zoom-in;
	}
	.grid__item[hidden] {
		display: none;
	}
	.grid__item[data-shape="wide"] {
		grid-column: span 2;
		grid-row: span 2;
	}
	.grid__item[data-shape="tall"] {
		grid-row: span 2;
	}
	.grid__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 300ms ease;
	}
	.grid__item:hover img {
		transform: scale(1.03);
	}
	.gallery__hint {
		margin: 20px var(--space-2) 0;
		font-size: var(--text-small);
		color: var(--ink-muted);
		text-align: center;
	}

	/* Viewer: full-screen modal dialog. Phone: counter and close on top, photo with arrows
	   over it, caption, thumbnail strip, swipe hint. */
	.viewer {
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgb(20 17 15);
		color: var(--on-dark-strong);
		overscroll-behavior: contain;
	}
	.viewer::backdrop {
		background: rgb(20 17 15);
	}
	.viewer[open] {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-rows: 64px minmax(0, 1fr) auto auto auto;
		grid-template-areas:
			"count close"
			"stage stage"
			"caption caption"
			"thumbs thumbs"
			"hint hint";
	}
	.viewer__count {
		grid-area: count;
		align-self: center;
		padding-left: 20px;
		color: var(--on-dark);
		font-size: var(--text-small);
		font-variant-numeric: tabular-nums;
	}
	.viewer__close,
	.viewer__arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-full);
		cursor: pointer;
	}
	.viewer__close {
		grid-area: close;
		margin-right: 12px;
		background: rgb(232 225 215 / 0.12);
		color: var(--on-dark-strong);
	}
	.viewer__close:hover {
		background: rgb(232 225 215 / 0.22);
	}
	.viewer__close :global(svg) {
		width: 22px;
		height: 22px;
	}
	.viewer__arrow {
		background: var(--tan);
		color: var(--espresso);
	}
	.viewer__arrow:hover:not(:disabled) {
		background: var(--tan-hover);
	}
	.viewer__arrow:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.viewer__arrow :global(svg) {
		width: 22px;
		height: 22px;
	}
	.viewer :focus-visible {
		outline: 2px solid var(--tan);
		outline-offset: 3px;
	}
	.viewer__stage {
		grid-area: stage;
		position: relative;
		display: grid;
		grid-template-rows: minmax(0, 1fr);
		min-height: 0;
		touch-action: pan-y;
	}
	.viewer__img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		user-select: none;
		-webkit-user-drag: none;
	}
	.viewer__arrow {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
	}
	.viewer__arrow--prev {
		left: 10px;
	}
	.viewer__arrow--next {
		right: 10px;
	}
	.viewer__caption {
		grid-area: caption;
		margin: 0;
		padding: 14px 20px 0;
		font-size: 16px;
		line-height: 1.4;
	}
	.viewer__thumbs {
		grid-area: thumbs;
		display: flex;
		gap: 6px;
		overflow-x: auto;
		padding: 14px 20px 28px;
		scrollbar-width: none;
	}
	.viewer__thumbs :global(button) {
		flex: none;
		width: 64px;
		height: 48px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		opacity: 0.55;
		cursor: pointer;
	}
	.viewer__thumbs :global(button:hover) {
		opacity: 0.85;
	}
	.viewer__thumbs :global(button[aria-current="true"]) {
		opacity: 1;
		outline: 2px solid var(--tan);
		outline-offset: 1px;
	}
	.viewer__thumbs :global(img) {
		width: 100%;
		height: 100%;
		border-radius: var(--radius-sm);
		object-fit: cover;
	}
	.viewer__hint {
		grid-area: hint;
		margin: 0 0 18px;
		color: var(--on-dark-muted);
		font-size: 13px;
		text-align: center;
	}
	:global(body:has(.viewer[open])) {
		overflow: hidden;
	}

	/* Desktop, 900px and up */
	@media (min-width: 900px) {
		.hero {
			height: 400px;
			padding: 0 var(--page-pad) 56px;
		}
		h1 {
			font-size: 52px;
			line-height: 1.1;
		}
		.gallery {
			padding: 48px var(--page-pad) 96px;
		}
		.filters {
			flex-wrap: wrap;
			justify-content: center;
			gap: 10px;
			margin-bottom: 36px;
			padding: 0;
		}
		.filters__btn {
			padding: 0 18px;
		}
		.grid {
			grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
			grid-auto-rows: auto;
			gap: 20px;
		}
		.grid__item,
		.grid__item[data-shape] {
			grid-column: auto;
			grid-row: auto;
			border-radius: var(--radius-lg);
			aspect-ratio: 4 / 3;
		}
		.gallery__hint,
		.viewer__hint {
			display: none;
		}

		.viewer[open] {
			grid-template-columns: auto 1fr auto;
			grid-template-rows: 72px minmax(0, 1fr) auto;
			grid-template-areas:
				"count caption close"
				"stage stage stage"
				"thumbs thumbs thumbs";
		}
		.viewer__count {
			padding-left: 32px;
			font-size: 16px;
		}
		.viewer__count::after {
			content: " ·";
		}
		.viewer__caption {
			align-self: center;
			padding: 0 0 0 8px;
			color: var(--on-dark);
		}
		.viewer__close {
			width: 48px;
			height: 48px;
			margin-right: 24px;
		}
		.viewer__close :global(svg) {
			width: 24px;
			height: 24px;
		}
		.viewer__stage {
			grid-template-columns: auto minmax(0, 1fr) auto;
			column-gap: 28px;
			align-items: center;
			padding: 0 28px;
		}
		.viewer__img {
			border-radius: var(--radius-sm);
		}
		.viewer__arrow {
			position: static;
			translate: none;
			width: 52px;
			height: 52px;
		}
		.viewer__arrow :global(svg) {
			width: 24px;
			height: 24px;
		}
		.viewer__thumbs {
			justify-content: safe center;
			gap: var(--space-2);
			padding: 20px 32px 24px;
		}
		.viewer__thumbs :global(button) {
			width: 88px;
			height: 60px;
		}
		.viewer__thumbs :global(button[aria-current="true"]) {
			outline-offset: 2px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.grid__item img {
			transition: none;
		}
		.grid__item:hover img {
			transform: none;
		}
	}
</style>
