---
/** A legal text from the `legal` collection in the current language, e.g. the privacy policy. */
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Footer from "../Footer.astro";
import Header from "../Header.astro";
import { getLang, useTranslations } from "../../i18n/ui";

interface Props {
	/** Page key; also the folder name in src/content/legal/. */
	page: "privacy";
}

const { page } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const entry = await getEntry("legal", `${page}/${lang}`);
if (!entry) throw new Error(`Missing legal text: ${page}/${lang}.md`);
const { Content } = await render(entry);
---

<Base
	page={page}
	title={`${entry.data.title} | Sunrise Villa`}
	description={entry.data.description}
>
	<Header page={page} />
	<main class="legal">
		<h1>{entry.data.title}</h1>
		<p class="legal__updated">
			{t("privacy.updated")} {entry.data.updated}
		</p>
		<div class="legal__body">
			<Content />
		</div>
	</main>
	<Footer />
</Base>

<style>
	/* Plain text page: one narrow column, no photo */
	.legal {
		max-width: calc(820px + 2 * var(--page-pad));
		margin-inline: auto;
		padding: 44px var(--page-pad) 56px;
	}
	h1 {
		margin: 0 0 6px;
		font-size: 32px;
		line-height: 1.2;
		font-weight: 700;
		overflow-wrap: break-word;
	}
	.legal__updated {
		margin: 0;
		font-size: var(--text-small);
		color: var(--ink-muted);
	}
	.legal__body :global(h2) {
		margin: 32px 0 8px;
		font-size: 21px;
		line-height: 1.3;
		font-weight: 700;
	}
	.legal__body :global(p) {
		margin: 0 0 14px;
	}
	.legal__body :global(ul),
	.legal__body :global(ol) {
		margin: 0 0 14px;
		padding-left: 1.4em;
	}
	.legal__body :global(li) {
		margin-bottom: 6px;
	}
	.legal__body :global(a) {
		overflow-wrap: anywhere;
	}

	@media (min-width: 900px) {
		.legal {
			padding-block: 80px 104px;
		}
		h1 {
			font-size: 44px;
			line-height: 1.15;
		}
		.legal__body :global(h2) {
			font-size: 24px;
		}
	}
</style>
