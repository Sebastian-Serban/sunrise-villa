---
/** Rooms page: photo banner, what every room has, then each room type with its photos. */
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { pageUrl } from "../../i18n/routes";
import Base from "../../layouts/Base.astro";
import Button from "../Button.astro";
import Footer from "../Footer.astro";
import Header from "../Header.astro";
import PageBanner from "../PageBanner.astro";
import Cta from "../home/Cta.astro";
import Facilities from "../home/Facilities.astro";
import heroImage from "../../assets/rooms/double-bed.jpg";
import { getLang, useTranslations, type UiKey } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const rooms = (await getCollection("rooms")).sort((a, b) => a.data.order - b.data.order);
const contact = pageUrl(lang, "contact");

// Shared by every room, so they are listed once instead of per room (decision 37)
const shared = ["ac", "tv", "minibar", "hairdryer", "bath", "toiletries"] as const;
---

<Base page="rooms" title={t("roomsPage.meta.title")} description={t("roomsPage.meta.description")}>
	<Header page="rooms" />
	<main>
		<PageBanner image={heroImage} title={t("roomsPage.title")} lead={t("roomsPage.lead")} tall />

		<section class="intro">
			<p class="intro__lead">{t("roomsPage.lead")}</p>
			<div class="shared">
				<h2 id="shared-title">{t("roomsPage.shared.title")}</h2>
				<ul class="shared__list" aria-labelledby="shared-title">
					{shared.map((key) => (
						<li>{t(`roomsPage.shared.${key}` as UiKey)}</li>
					))}
				</ul>
			</div>
		</section>

		<div class="rooms">
			{rooms.map(({ data }) => (
				<article id={data.anchor} class="room" aria-labelledby={`${data.anchor}-title`}>
					<div class="room__text">
						<h2 id={`${data.anchor}-title`}>{data.name[lang]}</h2>
						<p>{data.intro[lang]}</p>
					</div>
					<Button class="room__ask" href={`${contact}?camera=${data.anchor}#contact`} large>
						{data.ask[lang]}
					</Button>
					{/* Scrollable on phones, so it must be focusable for keyboard users (WCAG 2.1.1) */}
					{/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
					<div
						class="room__photos"
						tabindex="0"
						role="region"
						aria-label={`${t("roomsPage.photos")}: ${data.name[lang]}`}
					>
						{data.photos.map((photo) => (
							<Image
								src={photo.image}
								alt={photo.alt[lang]}
								widths={[400, 640, 900, 1200]}
								sizes="(min-width: 1200px) 380px, (min-width: 900px) 33vw, 80vw"
								loading="lazy"
							/>
						))}
					</div>
					{/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}
				</article>
			))}
		</div>

		<Facilities />
		<Cta eyebrow={t("roomsPage.cta.eyebrow")} desktopPhoto="pool" />
	</main>
	<Footer />
</Base>

<style>
	.intro {
		padding: 40px var(--page-pad) 8px;
	}
	.intro__lead {
		max-width: 640px;
		margin: 0 0 22px;
	}
	.shared {
		max-width: 640px;
		padding: 18px 18px 20px;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--white);
	}
	.shared h2 {
		margin: 0 0 12px;
		font-size: 18px;
		line-height: 1.3;
		font-weight: 700;
	}
	.shared__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-small);
		line-height: 1.6;
	}
	.shared__list li {
		padding: 4px 10px;
		border-radius: var(--radius-sm);
		background: var(--sand);
	}

	/* Phone: photo swipe row, then text, then the button */
	.rooms {
		padding-bottom: 56px;
	}
	.room {
		display: grid;
		grid-template-areas:
			"photos"
			"text"
			"ask";
		grid-template-columns: minmax(0, 1fr);
		max-width: 640px;
		margin-inline: auto;
		padding-top: 48px;
		scroll-margin-top: 16px;
	}
	.room:first-child {
		padding-top: 40px;
	}
	.room__photos {
		grid-area: photos;
		display: flex;
		gap: 14px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--page-pad);
		scrollbar-width: none;
		overscroll-behavior-x: contain;
		padding: 4px var(--page-pad) 8px;
	}
	.room__photos::-webkit-scrollbar {
		display: none;
	}
	.room__photos:focus-visible {
		outline-offset: -3px;
	}
	.room__photos :global(img) {
		flex: 0 0 80%;
		width: 80%;
		height: 250px;
		object-fit: cover;
		border-radius: var(--radius-lg);
		scroll-snap-align: start;
	}
	.room__text {
		grid-area: text;
		padding: 20px var(--page-pad) 0;
	}
	.room__text h2 {
		margin: 0 0 10px;
		font-size: 28px;
		line-height: 1.2;
		font-weight: 700;
	}
	.room__text p {
		margin: 0 0 20px;
	}
	.room :global(.room__ask) {
		grid-area: ask;
		display: flex;
		margin-inline: var(--page-pad);
		white-space: normal;
		text-align: center;
	}

	@media (min-width: 900px) {
		.intro {
			max-width: calc(var(--content-max) + 2 * var(--page-pad));
			margin-inline: auto;
			padding: 56px var(--page-pad) 0;
		}
		.intro__lead {
			display: none;
		}
		.shared {
			max-width: none;
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 16px 28px;
			padding: 22px 28px;
			border-radius: var(--radius-lg);
		}
		.shared h2 {
			margin: 0;
			font-size: 20px;
		}
		.shared__list {
			gap: 10px;
		}
		.shared__list li {
			padding: 6px 14px;
		}

		.rooms {
			padding-bottom: 40px;
		}
		.room {
			grid-template-areas:
				"text ask"
				"photos photos";
			grid-template-columns: minmax(0, 760px) auto;
			justify-content: space-between;
			align-items: end;
			gap: 24px 64px;
			max-width: calc(var(--content-max) + 2 * var(--page-pad));
			padding: 72px var(--page-pad) 0;
		}
		.room:first-child {
			padding-top: 72px;
		}
		.room__text {
			padding: 0;
		}
		.room__text h2 {
			margin-bottom: 12px;
			font-size: 36px;
		}
		.room__text p {
			margin: 0;
		}
		.room :global(.room__ask) {
			display: inline-flex;
			justify-self: end;
			margin: 0;
			min-height: 44px;
			font-size: 15px;
		}
		.room__photos {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 20px;
			overflow: visible;
			padding: 4px 0 0;
			margin-top: 4px;
		}
		.room__photos :global(img) {
			width: 100%;
			height: 320px;
		}
	}
</style>
