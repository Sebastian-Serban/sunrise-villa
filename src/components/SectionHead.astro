---
/**
 * Section heading with a lead paragraph. Left-aligned on phones, centred on desktop.
 * The section sets the space below it with --head-gap.
 */
interface Props {
	title: string;
	lead?: string;
	/** dark: on an espresso ground (tan heading, light text). */
	tone?: "light" | "dark";
	id?: string;
}

const { title, lead, tone = "light", id } = Astro.props;
---

<div class:list={["head", `head--${tone}`]}>
	<h2 id={id}>{title}</h2>
	{lead && <p>{lead}</p>}
</div>

<style>
	.head {
		margin-bottom: var(--head-gap, 24px);
	}
	h2 {
		margin: 0 0 12px;
		font-size: var(--text-h2);
		line-height: 1.2;
		font-weight: 700;
	}
	p {
		margin: 0;
	}
	.head--dark h2 {
		color: var(--tan);
	}
	.head--dark p {
		color: var(--on-dark);
	}
	@media (min-width: 900px) {
		.head {
			max-width: 820px;
			margin-inline: auto;
			text-align: center;
		}
		h2 {
			margin-bottom: 14px;
		}
	}
</style>
