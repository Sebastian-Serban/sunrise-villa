---
/**
 * Title block for pages without a photo hero (gallery, contact, legal, 404).
 * Leaves room for the absolutely positioned header above it.
 */
interface Props {
	label?: string;
	titleBefore: string;
	/** Italic last words, like the homepage hero. */
	titleAccent?: string;
	lead?: string;
	/** Use h2 sizing for long titles. */
	small?: boolean;
}

const { label, titleBefore, titleAccent, lead, small = false } = Astro.props;
---

<div class="wrap page-head">
	{label && <p class="label">{label}</p>}
	<h1 class:list={["serif", small ? "h2" : "h1", "page-head__title"]}>
		{titleBefore}
		{titleAccent && " "}
		{titleAccent && <em>{titleAccent}</em>}
	</h1>
	{lead && <p class="lead muted page-head__lead">{lead}</p>}
	<slot />
</div>

<style>
	.page-head {
		padding-top: calc(140px + var(--space-16));
	}
	.page-head__title {
		max-width: 15em;
	}
	.page-head__lead {
		margin-top: var(--space-6);
	}
	@media (max-width: 900px) {
		.page-head {
			padding-top: calc(96px + var(--space-8));
		}
	}
</style>
