---
/**
 * Reusable carousel built on CSS scroll-snap. The children are the slides.
 *
 * Phone (< 900px): swipe row with peeking slides and dots, or (mobile="stack") a plain
 * vertical list. Desktop (>= 900px): `cols` slides per view with round arrow buttons.
 * Arrows and dots are real buttons; the scroll area is keyboard-scrollable (left/right arrows).
 * Without JS it is still a scrollable row. Respects prefers-reduced-motion.
 *
 * Slides must be direct children. Give them their own look; this component only sets
 * their width and snapping.
 */
import AppIcon from "./AppIcon.astro";

interface Props {
	/** Accessible name of the carousel region, e.g. "Camere". */
	label: string;
	prevLabel: string;
	nextLabel: string;
	/** Prefix of the dot buttons' accessible name; the slide number is appended. */
	dotLabel?: string;
	/** Phone layout: horizontal swipe row, or a vertical list with no carousel controls. */
	mobile?: "swipe" | "stack";
	/** Show dots (one per scroll position). */
	dots?: boolean;
	/** Slides per view from 900px and from 1200px. */
	cols?: [number, number];
	/** Gap between slides from 900px, in px. */
	gap?: number;
	/** Space reserved on each side of the slides for the arrows, in px. */
	inset?: number;
	/** Where the arrows sit relative to the stage edge, in px (negative = outside). */
	arrowOffset?: number;
}

const {
	label,
	prevLabel,
	nextLabel,
	dotLabel = "",
	mobile = "swipe",
	dots = false,
	cols = [1, 2],
	gap = 40,
	inset = 40,
	arrowOffset = -8,
} = Astro.props;
const style = `--cols-mid:${cols[0]};--cols-wide:${cols[1]};--gap:${gap}px;--inset:${inset}px;--arrow-offset:${arrowOffset}px`;
---

<sv-carousel class="carousel" data-mobile={mobile} data-dot-label={dotLabel} style={style}>
	<div class="carousel__stage">
		<div class="carousel__viewport" tabindex="0" role="region" aria-label={label} data-viewport>
			<div class="carousel__track" data-track>
				<slot />
			</div>
		</div>
		<button
			class="carousel__arrow carousel__arrow--prev"
			type="button"
			aria-label={prevLabel}
			data-prev
		>
			<AppIcon name="ChevronLeft" stroke-width={2.4} />
		</button>
		<button
			class="carousel__arrow carousel__arrow--next"
			type="button"
			aria-label={nextLabel}
			data-next
		>
			<AppIcon name="ChevronRight" stroke-width={2.4} />
		</button>
	</div>
	{dots && <div class="carousel__dots" data-dots></div>}
</sv-carousel>

<script>
	class SvCarousel extends HTMLElement {
		private viewport!: HTMLElement;
		private track!: HTMLElement;
		private prev!: HTMLButtonElement;
		private next!: HTMLButtonElement;
		private dotsEl: HTMLElement | null = null;
		private step = 0;
		private positions = 1;
		private frame = 0;

		connectedCallback() {
			this.viewport = this.querySelector<HTMLElement>("[data-viewport]")!;
			this.track = this.querySelector<HTMLElement>("[data-track]")!;
			this.prev = this.querySelector<HTMLButtonElement>("[data-prev]")!;
			this.next = this.querySelector<HTMLButtonElement>("[data-next]")!;
			this.dotsEl = this.querySelector<HTMLElement>("[data-dots]");

			this.prev.addEventListener("click", () => this.go(this.index() - this.perView()));
			this.next.addEventListener("click", () => this.go(this.index() + this.perView()));
			this.viewport.addEventListener("scroll", () => this.schedule(), { passive: true });
			this.viewport.addEventListener("keydown", (event) => {
				if (this.step === 0) return;
				if (event.key === "ArrowRight") {
					event.preventDefault();
					this.go(this.index() + 1);
				} else if (event.key === "ArrowLeft") {
					event.preventDefault();
					this.go(this.index() - 1);
				}
			});
			new ResizeObserver(() => this.measure()).observe(this.viewport);
			this.measure();
		}

		private slides(): HTMLElement[] {
			return Array.from(this.track.children) as HTMLElement[];
		}

		private perView(): number {
			const slides = this.slides();
			if (this.step === 0 || slides.length === 0) return 1;
			const gap = this.step - slides[0].offsetWidth;
			return Math.max(1, Math.floor((this.viewport.clientWidth + gap) / this.step + 0.02));
		}

		private index(): number {
			if (this.step === 0) return 0;
			const max = this.viewport.scrollWidth - this.viewport.clientWidth;
			if (this.viewport.scrollLeft >= max - 2) return this.positions - 1;
			const i = Math.round(this.viewport.scrollLeft / this.step);
			return Math.min(Math.max(i, 0), this.positions - 1);
		}

		/** Recompute slide step and number of scroll positions, rebuild the dots. */
		private measure() {
			const slides = this.slides();
			const scrollable = this.viewport.scrollWidth > this.viewport.clientWidth + 1;
			this.step = slides.length > 1 && scrollable ? slides[1].offsetLeft - slides[0].offsetLeft : 0;
			// Stacked slides share the same left edge, so step is 0 and the controls stay hidden
			this.toggleAttribute("data-static", this.step <= 0);
			this.positions = this.step > 0 ? Math.max(1, slides.length - this.perView() + 1) : 1;
			if (this.dotsEl) {
				if (this.dotsEl.childElementCount !== this.positions) {
					const label = this.dataset.dotLabel ?? "";
					this.dotsEl.replaceChildren(
						...Array.from({ length: this.positions }, (_, i) => {
							const dot = document.createElement("button");
							dot.type = "button";
							dot.className = "carousel__dot";
							dot.setAttribute("aria-label", `${label} ${i + 1}`.trim());
							dot.addEventListener("click", () => this.go(i));
							return dot;
						}),
					);
				}
			}
			this.update();
		}

		private go(target: number) {
			if (this.step === 0) return;
			const i = Math.min(Math.max(target, 0), this.positions - 1);
			const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
			this.viewport.scrollTo({ left: i * this.step, behavior: reduce ? "auto" : "smooth" });
		}

		private schedule() {
			if (this.frame) return;
			this.frame = requestAnimationFrame(() => {
				this.frame = 0;
				this.update();
			});
		}

		private update() {
			const i = this.index();
			this.prev.setAttribute("aria-disabled", String(i <= 0));
			this.next.setAttribute("aria-disabled", String(i >= this.positions - 1));
			this.dotsEl?.querySelectorAll("button").forEach((dot, n) => {
				if (n === i) dot.setAttribute("aria-current", "true");
				else dot.removeAttribute("aria-current");
			});
		}
	}
	customElements.define("sv-carousel", SvCarousel);
</script>

<style>
	.carousel {
		display: block;
		--phone-gap: 14px;
		--phone-pad: 24px;
	}
	.carousel__stage {
		position: relative;
	}

	/* Phone: swipe row with peeking slides, snapping to the slide start */
	.carousel__viewport {
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--phone-pad);
		scrollbar-width: none;
		overscroll-behavior-x: contain;
		border-radius: var(--radius-lg);
	}
	.carousel__viewport::-webkit-scrollbar {
		display: none;
	}
	.carousel__viewport:focus-visible {
		outline: 2px solid var(--tan-deep);
		outline-offset: -2px;
	}
	.carousel__track {
		display: flex;
		gap: var(--phone-gap);
		padding: 4px var(--phone-pad) 8px;
	}
	.carousel__track > :global(*) {
		flex: 0 0 80%;
		min-width: 0;
		scroll-snap-align: start;
	}

	/* Phone, stacked: no carousel at all */
	.carousel[data-mobile="stack"] .carousel__viewport {
		overflow: visible;
		scroll-snap-type: none;
	}
	.carousel[data-mobile="stack"] .carousel__track {
		flex-direction: column;
		gap: 32px;
		padding: 0;
	}
	.carousel[data-mobile="stack"] .carousel__track > :global(*) {
		flex: none;
	}

	.carousel__arrow {
		display: none;
		position: absolute;
		top: 50%;
		z-index: 2;
		width: 44px;
		height: 44px;
		margin-top: -22px;
		padding: 0;
		border: 0;
		border-radius: var(--radius-full);
		background: var(--tan);
		color: var(--espresso);
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}
	.carousel__arrow:hover {
		background: var(--tan-hover);
	}
	.carousel__arrow[aria-disabled="true"] {
		opacity: 0.4;
		cursor: default;
	}
	.carousel__arrow--prev {
		left: var(--arrow-offset);
	}
	.carousel__arrow--next {
		right: var(--arrow-offset);
	}

	.carousel__dots {
		display: flex;
		justify-content: center;
		margin-top: 6px;
	}
	.carousel[data-static] .carousel__dots {
		display: none;
	}
	.carousel__dots :global(.carousel__dot) {
		width: 16px;
		height: 24px;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: pointer;
		position: relative;
	}
	.carousel__dots :global(.carousel__dot)::before {
		content: "";
		position: absolute;
		top: 8px;
		left: 4px;
		width: 8px;
		height: 8px;
		border-radius: 4px;
		background: var(--border);
	}
	.carousel__dots :global(.carousel__dot[aria-current="true"]) {
		width: 30px;
	}
	.carousel__dots :global(.carousel__dot[aria-current="true"])::before {
		width: 22px;
		background: var(--tan);
	}

	/* Desktop: slides per view, arrows */
	@media (min-width: 900px) {
		.carousel {
			--cols: var(--cols-mid);
		}
		.carousel__stage {
			padding-inline: var(--inset);
		}
		.carousel__viewport,
		.carousel[data-mobile="stack"] .carousel__viewport {
			overflow-x: auto;
			overflow-y: hidden;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: 0;
			border-radius: 0;
			/* room for the cards' shadows, which overflow-x would otherwise clip */
			margin-block: -16px -40px;
		}
		.carousel__track,
		.carousel[data-mobile="stack"] .carousel__track {
			flex-direction: row;
			gap: var(--gap);
			padding: 16px 0 40px;
		}
		.carousel__track > :global(*),
		.carousel[data-mobile="stack"] .carousel__track > :global(*) {
			flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
		}
		.carousel__arrow {
			display: flex;
		}
		.carousel[data-static] .carousel__arrow {
			display: none;
		}
		.carousel__dots {
			margin-top: 28px;
		}
	}
	@media (min-width: 1200px) {
		.carousel {
			--cols: var(--cols-wide);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.carousel__viewport {
			scroll-behavior: auto;
		}
	}
</style>
