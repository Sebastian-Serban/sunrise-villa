---
/**
 * Homepage, shared by every language route.
 * Work in progress: hero and rooms are ported from the design canvas;
 * the remaining sections follow the same pattern (see the design canvas).
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Sweep from './Sweep.astro';
import hero from '../assets/hero.jpg';
import { BOOKING_URL, getLang, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const rooms = (await getCollection('rooms')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
	<Header />
	<main>
		<section class="hero">
			<Image
				class="hero__bg"
				src={hero}
				alt=""
				widths={[800, 1280, 1920, 2400]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="hero__scrim"></div>
			<div class="wrap hero__content">
				<p class="label hero__kicker">{t('hero.kicker')}</p>
				<h1 class="serif h1 hero__title">
					{t('hero.title.before')} <em>{t('hero.title.accent')}</em>
				</h1>
				<p class="lead hero__lead">{t('hero.lead')}</p>
				<div class="hero__actions">
					<a class="btn btn--tan" href={BOOKING_URL}>
						{t('cta.bookOnBooking')}
					</a>
					<a class="btn btn--ghost-dark" href="#camere">
						{t('cta.seeRooms')}
					</a>
				</div>
			</div>
			<div class="hero__sweep">
				<Sweep from="transparent" to="surface" line />
			</div>
		</section>

		<section id="camere" class="section rooms">
			<div class="wrap">
				<p class="label">{t('rooms.label')}</p>
				<h2 class="serif h2">{t('rooms.title')}</h2>
				<p class="lead muted rooms__lead">{t('rooms.lead')}</p>
				<div class="rooms__grid">
					{rooms.map(({ data }) => (
						<article class="room">
							<Image
								src={data.image}
								alt={data.imageAlt[lang]}
								widths={[480, 800, 1200]}
								sizes="(max-width: 720px) 100vw, 50vw"
								class="room__img"
							/>
							<div class="room__body">
								<h3 class="serif h3">{data.name[lang]}</h3>
								<ul class="room__chips">
									<li>{data.beds[lang]}</li>
									<li>
										{data.maxPersons} {t('rooms.persons')}
									</li>
									<li>{data.sizeM2} m²</li>
								</ul>
								<p class="muted">{data.description[lang]}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>
</Base>

<style>
	.hero {
		position: relative;
		min-height: 940px;
		display: flex;
		align-items: flex-end;
		color: var(--on-dark);
		background: var(--espresso);
	}
	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero__scrim {
		position: absolute;
		inset: 0;
		background: rgb(45 41 38 / 0.5);
	}
	.hero__content {
		position: relative;
		z-index: 2;
		width: 100%;
		padding-bottom: 250px;
	}
	.hero__kicker {
		color: var(--sand);
	}
	.hero__title {
		max-width: 760px;
	}
	.hero__title em {
		font-style: italic;
	}
	.hero__lead {
		margin-top: 28px;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: 36px;
	}
	/* The sweep sits on top of the photo's bottom edge */
	.hero__sweep {
		position: absolute;
		inset: auto 0 -1px;
		z-index: 1;
	}

	.rooms__lead {
		margin-top: var(--space-6);
	}
	.rooms__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 40px;
		margin-top: 72px;
	}
	.room {
		background: var(--surface-raised);
	}
	.room:nth-child(even) {
		margin-top: 96px;
	}
	.room__img {
		width: 100%;
		aspect-ratio: 5 / 4;
		object-fit: cover;
	}
	.room__body {
		padding: 36px 40px 40px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.room__body p {
		margin: 0;
	}
	.room__chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.room__chips li {
		background: var(--sand);
		padding: 8px 12px;
		font-size: var(--text-small);
		line-height: 20px;
		border-radius: var(--radius-sm);
	}

	@media (max-width: 720px) {
		.hero {
			min-height: 780px;
		}
		.hero__content {
			padding-bottom: 160px;
		}
		.rooms__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 28px;
		}
		.room:nth-child(even) {
			margin-top: 0;
		}
		.room__body {
			padding: 28px 24px 32px;
		}
	}
</style>
