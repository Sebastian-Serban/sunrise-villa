---
/**
 * Homepage, shared by every language route.
 * Sections only know about themselves; the <Sweep> dividers between them live
 * here because each one depends on the grounds of both neighbours.
 */
import Base from "../layouts/Base.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import MobileNav from "./MobileNav.astro";
import Sweep from "./Sweep.astro";
import Contact from "./sections/Contact.astro";
import Facilities from "./sections/Facilities.astro";
import Facts from "./sections/Facts.astro";
import Faq from "./sections/Faq.astro";
import Hero from "./sections/Hero.astro";
import Reviews from "./sections/Reviews.astro";
import Rooms from "./sections/Rooms.astro";
import Seasons from "./sections/Seasons.astro";
import Spaces from "./sections/Spaces.astro";
import Surroundings from "./sections/Surroundings.astro";
---

<Base>
	<Header />
	<MobileNav />
	<main>
		<Hero />
		<Facts />
		<Rooms />
		<Sweep from="surface" to="sand" />
		<Spaces />
		<Sweep from="sand" to="tan" shape="rise" line />
		<Facilities />
		<Sweep from="tan" to="surface" />
		<Seasons />
		<Surroundings />
		<Sweep from="surface" to="espresso" shape="rise" />
		<Reviews />
		<Sweep from="espresso" to="surface" />
		<Faq />
		<Contact />
	</main>
	<Footer />
</Base>
