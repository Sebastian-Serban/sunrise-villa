---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Button from "../Button.astro";
import Carousel from "../Carousel.astro";
import SectionHead from "../SectionHead.astro";
import { getLang, useTranslations } from "../../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const parks = (await getCollection("attractions"))
	.filter((entry) => entry.data.kind === "aquapark")
	.sort((a, b) => a.data.order - b.data.order);
---

<section class="aqua">
	<div class="wrap">
		<SectionHead title={t("aquaparks.title")} lead={t("aquaparks.lead")} />
		<div class="bleed-phone">
			<Carousel
				label={t("aquaparks.title")}
				prevLabel={t("carousel.prev")}
				nextLabel={t("carousel.next")}
				dotLabel={t("carousel.dot")}
				cols={[2, 2]}
				inset={0}
				dots
			>
				{parks.map(({ data }) => (
					<article class="card">
						<Image
							class="card__img"
							src={data.image}
							alt={data.imageAlt?.[lang] ?? ""}
							widths={[400, 640, 900]}
							sizes="(min-width: 900px) 560px, 80vw"
							loading="lazy"
						/>
						<div class="card__body">
							<h3>{data.name[lang]}</h3>
							<p>
								<span class="card__long">{data.summary?.[lang]}</span>
								<span class="card__short">{data.summaryShort?.[lang]}</span>
							</p>
							{data.url && <Button href={data.url}>{t("aquaparks.details")}</Button>}
						</div>
					</article>
				))}
			</Carousel>
		</div>
	</div>
</section>

<style>
	.aqua {
		--head-gap: 22px;
		padding-block: 52px 40px;
	}
	.card {
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--white);
	}
	.card__img {
		display: block;
		width: 100%;
		height: 180px;
		object-fit: cover;
	}
	.card__body {
		padding: 16px 18px 20px;
	}
	h3 {
		margin: 0 0 6px;
		font-size: 20px;
		line-height: 1.3;
		font-weight: 700;
	}
	p {
		margin: 0;
		font-size: 16px;
	}
	.card__body > :global(.btn) {
		margin-top: 14px;
	}
	.card__long {
		display: none;
	}
	@media (min-width: 900px) {
		.aqua {
			--head-gap: 48px;
			padding-block: 24px 104px;
		}
		.card {
			border-color: var(--border-strong);
		}
		.card__img {
			height: 320px;
		}
		.card__body {
			padding: 26px 28px 30px;
		}
		h3 {
			margin-bottom: 10px;
			font-size: 26px;
		}
		.card__body > :global(.btn) {
			margin-top: 20px;
		}
		.card__long {
			display: inline;
		}
		.card__short {
			display: none;
		}
	}
</style>
