---
import { Image } from "astro:assets";
import Button from "../Button.astro";
import { pageUrl } from "../../i18n/routes";
import { BOOKING_URL, getLang, useTranslations } from "../../i18n/ui";
import hero from "../../assets/hero.jpg";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="hero">
	<Image
		class="hero__img"
		src={hero}
		alt=""
		widths={[640, 960, 1440, 1920]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="hero__scrim"></div>
	<div class="hero__content">
		<h1>
			Sunrise Villa{" "}
			<span class="hero__stars" aria-hidden="true">
				★★★
			</span>
			<span class="visually-hidden">{t("hero.stars")}</span>
		</h1>
		<p class="hero__tagline">{t("hero.tagline")}</p>
		<div class="hero__actions">
			<Button href={BOOKING_URL} large>
				{t("cta.bookNow")}
			</Button>
			<Button href={pageUrl(lang, "rooms")} variant="outline-photo" large>
				{t("cta.seeRooms")}
			</Button>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		height: 620px;
		padding: 0 var(--page-pad) 40px;
		color: var(--white);
	}
	.hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.hero__scrim {
		position: absolute;
		inset: 0;
		background: rgb(20 17 15 / 0.48);
	}
	.hero__content {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	h1 {
		margin: 0;
		font-size: var(--text-h1);
		line-height: 1.1;
		font-weight: 700;
		color: var(--tan);
	}
	.hero__stars {
		white-space: nowrap;
	}
	.hero__tagline {
		margin: 0 0 10px;
		font-size: 20px;
		font-weight: 500;
	}
	.hero__actions {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.hero__actions :global(.btn) {
		display: flex;
	}

	@media (min-width: 900px) {
		.hero {
			align-items: center;
			justify-content: center;
			height: 760px;
			padding: 0;
		}
		.hero__scrim {
			background: rgb(20 17 15 / 0.42);
		}
		.hero__content {
			width: 100%;
			max-width: var(--wide-max);
			padding: 0 64px;
			align-items: flex-start;
		}
		.hero__tagline {
			margin-bottom: 16px;
			font-size: 30px;
			line-height: 1.3;
			font-weight: 700;
		}
		.hero__actions {
			flex-direction: row;
			flex-wrap: wrap;
		}
		.hero__actions :global(.btn) {
			display: inline-flex;
			min-height: 44px;
			font-size: 15px;
		}
	}
</style>
