---
/**
 * A room's photos: one large image and a thumbnail row to switch it.
 * All images are rendered up front; the custom element only toggles `hidden`.
 * Without JS the first photo shows and the thumbnails still show the others.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getLang, useTranslations } from "../i18n/ui";

interface Props {
	photos: { image: ImageMetadata; alt: string }[];
}

const { photos } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<room-photos class="room-photos">
	<div class="room-photos__main">
		{photos.map((photo, i) => (
			<Image
				src={photo.image}
				alt={photo.alt}
				widths={[600, 900, 1200]}
				sizes="(max-width: 1000px) 100vw, 58vw"
				hidden={i > 0}
				data-photo
			/>
		))}
	</div>
	{photos.length > 1 && (
		<div class="room-photos__thumbs">
			{photos.map((photo, i) => (
				<button
					type="button"
					class="room-photos__thumb"
					aria-pressed={i === 0 ? "true" : "false"}
					aria-label={`${t("roomsPage.showPhoto")} ${i + 1}`}
					data-thumb={i}
				>
					<Image src={photo.image} alt="" widths={[240, 400]} sizes="20vw" />
				</button>
			))}
		</div>
	)}
</room-photos>

<script>
	class RoomPhotos extends HTMLElement {
		connectedCallback() {
			const photos = this.querySelectorAll<HTMLElement>("[data-photo]");
			const thumbs = this.querySelectorAll<HTMLButtonElement>("[data-thumb]");
			thumbs.forEach((thumb) =>
				thumb.addEventListener("click", () => {
					const index = Number(thumb.dataset.thumb);
					photos.forEach((photo, i) => (photo.hidden = i !== index));
					thumbs.forEach((t, i) => t.setAttribute("aria-pressed", String(i === index)));
				}),
			);
		}
	}
	customElements.define("room-photos", RoomPhotos);
</script>

<style>
	.room-photos {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}
	.room-photos__main {
		grid-column: 1 / -1;
		aspect-ratio: 4 / 3;
		background: var(--photo-placeholder);
	}
	.room-photos__main img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.room-photos__main img[hidden] {
		display: none;
	}
	.room-photos__thumbs {
		display: contents;
	}
	.room-photos__thumb {
		aspect-ratio: 4 / 3;
		padding: 0;
		border: 0;
		background: var(--photo-placeholder);
		cursor: pointer;
	}
	.room-photos__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.room-photos__thumb[aria-pressed="true"] {
		outline: 2px solid var(--espresso);
		outline-offset: 3px;
	}
	.room-photos__thumb:focus-visible {
		outline: 2px solid var(--tan-deep);
		outline-offset: 3px;
	}
	@media (max-width: 720px) {
		.room-photos {
			gap: 8px;
			margin-inline: calc(-1 * var(--page-pad));
		}
	}
</style>
