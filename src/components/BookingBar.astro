---
/**
 * Dates + guests, handed off to Booking.com.
 * With BOOKING_PROPERTY_URL set, the dates and guests are passed along;
 * without it, the button falls back to the share link (dates ignored).
 */
import { BOOKING_PROPERTY_URL, BOOKING_URL, getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));
const guests = [
	{ value: "1-0", label: t("booking.guests.1") },
	{ value: "2-0", label: t("booking.guests.2"), selected: true },
	{ value: "2-1", label: t("booking.guests.3") },
	{ value: "2-2", label: t("booking.guests.4") },
];
---

<booking-bar data-property={BOOKING_PROPERTY_URL ?? ""} data-fallback={BOOKING_URL}>
	<form class="bar" aria-label={t("booking.label")}>
		<div class="field">
			<label for="booking-checkin">{t("booking.checkin")}</label>
			<input id="booking-checkin" name="checkin" type="date" />
		</div>
		<div class="field">
			<label for="booking-checkout">{t("booking.checkout")}</label>
			<input id="booking-checkout" name="checkout" type="date" />
		</div>
		<div class="field field--wide">
			<label for="booking-guests">{t("booking.guests")}</label>
			<select id="booking-guests" name="guests">
				{guests.map((g) => (
					<option value={g.value} selected={g.selected}>
						{g.label}
					</option>
				))}
			</select>
		</div>
		<button class="btn btn--primary bar__submit" type="submit">
			{t("booking.submit")}
		</button>
	</form>
	<p class="note">{t("booking.note")}</p>
</booking-bar>

<script>
	const toIso = (d: Date) => d.toISOString().slice(0, 10);

	class BookingBar extends HTMLElement {
		connectedCallback() {
			const form = this.querySelector("form")!;
			const checkin = form.elements.namedItem("checkin") as HTMLInputElement;
			const checkout = form.elements.namedItem("checkout") as HTMLInputElement;
			const today = new Date();
			checkin.min = toIso(today);
			checkout.min = toIso(new Date(today.getTime() + 86_400_000));

			checkin.addEventListener("change", () => {
				if (!checkin.value) return;
				const next = new Date(`${checkin.value}T12:00:00`);
				next.setDate(next.getDate() + 1);
				checkout.min = toIso(next);
				if (!checkout.value || checkout.value <= checkin.value) checkout.value = toIso(next);
			});

			form.addEventListener("submit", (event) => {
				event.preventDefault();
				const property = this.dataset.property;
				if (!property) {
					window.location.href = this.dataset.fallback!;
					return;
				}
				const [adults, children] = (
					form.elements.namedItem("guests") as HTMLSelectElement
				).value.split("-");
				const url = new URL(property);
				if (checkin.value) url.searchParams.set("checkin", checkin.value);
				if (checkout.value) url.searchParams.set("checkout", checkout.value);
				url.searchParams.set("group_adults", adults!);
				url.searchParams.set("group_children", children!);
				url.searchParams.set("no_rooms", "1");
				window.location.href = url.toString();
			});
		}
	}
	customElements.define("booking-bar", BookingBar);
</script>

<style>
	booking-bar {
		display: block;
		max-width: 920px;
	}
	.bar {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
		background: var(--surface-raised);
		color: var(--ink);
		padding: var(--space-2);
	}
	.field {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 2px;
		padding: 6px 18px;
		border-right: 1px solid var(--line);
	}
	.field label {
		font-size: 13px;
		line-height: 18px;
		font-weight: 600;
		color: var(--ink-muted);
	}
	.field input,
	.field select {
		font: inherit;
		font-size: var(--text-body);
		border: 0;
		background: transparent;
		color: var(--ink);
		height: 32px;
		padding: 0;
		width: 100%;
	}
	.bar__submit {
		min-height: 64px;
		margin-left: var(--space-2);
	}
	.note {
		margin: 14px 0 0;
		font-size: var(--text-small);
		line-height: 22px;
		color: var(--sand);
	}
	@media (max-width: 720px) {
		.bar {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			padding: 6px;
		}
		.field {
			border-right: 0;
			border-bottom: 1px solid var(--line);
			padding: 8px 12px;
		}
		.field + .field:not(.field--wide) {
			border-left: 1px solid var(--line);
		}
		.field--wide {
			grid-column: 1 / -1;
		}
		.bar__submit {
			grid-column: 1 / -1;
			margin: 6px 0 0;
			min-height: 56px;
		}
	}
</style>
