---
import "../styles/global.css";
import FloatingContact from "../components/FloatingContact.astro";
import { pageAbsoluteUrl, type Page } from "../i18n/routes";
import { getLang, languages, useTranslations, type Lang } from "../i18n/ui";

interface Props {
	/** Which page this is, for canonical and hreflang links. */
	page?: Page;
	title?: string;
	description?: string;
	/** Keep out of search results and skip canonical/hreflang (404). */
	noindex?: boolean;
}

const { page = "home", title, description, noindex = false } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const pageTitle = title ?? t("meta.title");
const pageDescription = description ?? t("meta.description");
const canonical = pageAbsoluteUrl(lang, page);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		{noindex ? (
			<meta name="robots" content="noindex" />
		) : (
			<>
				<link rel="canonical" href={canonical} />
				{(Object.keys(languages) as Lang[]).map((l) => (
					<link rel="alternate" hreflang={l} href={pageAbsoluteUrl(l, page)} />
				))}
				<link rel="alternate" hreflang="x-default" href={pageAbsoluteUrl("ro", page)} />
			</>
		)}
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta name="theme-color" content="#2d2926" />
	</head>
	<body>
		<slot />
		<FloatingContact />
		<script>
			import "../scripts/draw-strokes";
		</script>
	</body>
</html>
