---
/**
 * Not-found page. Static hosts serve one 404 for every path, so this is
 * Romanian only (the default language).
 */
import { pageUrl } from "../i18n/routes";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { useTranslations } from "../i18n/ui";

const t = useTranslations("ro");
---

<Base noindex title={t("notFound.meta.title")} description={t("notFound.lead")}>
	<Header />
	<main class="not-found">
		<div class="not-found__shape" data-draw aria-hidden="true">
			<svg viewBox="0 0 1440 860" preserveAspectRatio="none">
				<path
					fill="var(--tan)"
					d="M1440 120 C 1240 110, 1020 180, 920 320 C 820 460, 900 560, 760 660 C 620 760, 300 760, 0 780 L0 860 L1440 860 Z"
				></path>
			</svg>
			<svg viewBox="0 0 1440 860" preserveAspectRatio="none">
				<path
					class="ink-line"
					stroke="var(--espresso)"
					d="M1460 90 C 1240 84, 1010 150, 900 290 C 840 370, 860 440, 920 440 C 980 440, 976 370, 920 372 C 850 376, 860 500, 800 580 C 700 720, 360 730, -20 750"
				></path>
			</svg>
		</div>
		<div class="wrap not-found__text">
			<p class="serif not-found__code">404</p>
			<h1 class="serif h2">
				{t("notFound.title.before")} <em>{t("notFound.title.accent")}</em>
			</h1>
			<p class="lead muted not-found__lead">{t("notFound.lead")}</p>
			<div class="not-found__links">
				<a class="btn btn--primary" href={pageUrl("ro", "home")}>
					{t("notFound.home")}
				</a>
				<a class="btn btn--ghost" href={pageUrl("ro", "rooms")}>
					{t("nav.rooms")}
				</a>
				<a class="btn btn--ghost" href={pageUrl("ro", "contact")}>
					{t("nav.contact")}
				</a>
			</div>
		</div>
	</main>
	<Footer />
</Base>

<style>
	.not-found {
		position: relative;
		min-height: 860px;
		overflow: hidden;
	}
	.not-found__shape {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.not-found__shape svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.not-found__text {
		position: relative;
		z-index: 1;
		padding-top: calc(140px + var(--space-24));
	}
	.not-found__code {
		margin: 0 0 var(--space-6);
		font-size: 200px;
		line-height: 180px;
		color: var(--espresso);
	}
	.not-found__lead {
		margin-top: 20px;
	}
	.not-found__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: 40px;
	}
	@media (max-width: 720px) {
		.not-found {
			min-height: 760px;
		}
		.not-found__text {
			padding-top: calc(96px + var(--space-12));
		}
		.not-found__code {
			font-size: 120px;
			line-height: 110px;
		}
	}
</style>
