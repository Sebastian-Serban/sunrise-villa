---
/**
 * Not-found page. Static hosts serve one 404 for every path, so this is
 * Romanian only (the default language).
 * Phone: plain centred text. Desktop: the same text over a photo.
 */
import { Image } from "astro:assets";
import { pageUrl } from "../i18n/routes";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import hero from "../assets/hero.jpg";
import { useTranslations } from "../i18n/ui";

const t = useTranslations("ro");
---

<Base noindex title={t("notFound.meta.title")} description={t("notFound.lead")}>
	<Header />
	<main class="not-found">
		<Image
			class="not-found__img"
			src={hero}
			alt=""
			widths={[960, 1440, 1920]}
			sizes="100vw"
			loading="lazy"
		/>
		<div class="not-found__scrim"></div>
		<div class="not-found__content">
			<p class="not-found__code" aria-hidden="true">
				404
			</p>
			<h1>{t("notFound.title")}</h1>
			<p class="not-found__lead">{t("notFound.lead")}</p>
			<div class="not-found__actions">
				<Button href={pageUrl("ro", "home")} large>
					{t("notFound.home")}
				</Button>
				<Button href={pageUrl("ro", "rooms")} variant="outline" large>
					{t("cta.seeRooms")}
				</Button>
			</div>
		</div>
	</main>
	<Footer />
</Base>

<style>
	.not-found {
		position: relative;
		padding: 72px var(--page-pad) 80px;
		text-align: center;
	}
	.not-found__img,
	.not-found__scrim {
		display: none;
	}
	.not-found__content {
		position: relative;
		max-width: 640px;
		margin-inline: auto;
	}
	.not-found__code {
		margin: 0;
		font-size: 72px;
		line-height: 1;
		font-weight: 700;
		color: var(--tan);
	}
	h1 {
		margin: 14px 0 8px;
		font-size: 28px;
		line-height: 1.2;
		font-weight: 700;
	}
	.not-found__lead {
		margin: 0 0 28px;
	}
	.not-found__actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	@media (min-width: 900px) {
		.not-found {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 620px;
			padding: 80px var(--page-pad);
			color: var(--white);
		}
		.not-found__img {
			display: block;
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.not-found__scrim {
			display: block;
			position: absolute;
			inset: 0;
			background: rgb(20 17 15 / 0.6);
		}
		.not-found__code {
			font-size: 96px;
		}
		h1 {
			margin: 16px 0 10px;
			font-size: 36px;
		}
		.not-found__lead {
			margin-bottom: 30px;
			font-size: 18px;
		}
		.not-found__actions {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: center;
			gap: 14px;
		}
		.not-found__actions :global(.btn) {
			min-height: 44px;
			font-size: 15px;
		}
		.not-found__actions :global(.btn--outline) {
			border-color: var(--tan);
			color: var(--white);
		}
		.not-found__actions :global(.btn--outline:hover) {
			background: var(--tan);
			color: var(--espresso);
		}
	}
</style>
